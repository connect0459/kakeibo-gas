{
  "$schema": "https://biomejs.dev/schemas/2.2.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/src/**/*.ts",
      "**/src/**/*.js",
      "**/*.js",
      "**/*.json",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/*.min.js"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off",
        "useConst": "error",
        "useTemplate": "off"
      },
      "complexity": {
        "noBannedTypes": "error",
        "noUselessCatch": "error",
        "noStaticOnlyClass": "off",
        "useOptionalChain": "off",
        "useDateNow": "off"
      },
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "off",
        "useParseIntRadix": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noImplicitAnyLet": "error",
        "noGlobalIsNan": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "includes": ["**", "!**/dist/**", "!**/node_modules/**"]
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "all",
      "semicolons": "always",
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    },
    "globals": [
      "SpreadsheetApp",
      "HtmlService",
      "DriveApp",
      "ScriptApp",
      "UrlFetchApp",
      "Utilities",
      "Logger",
      "console"
    ]
  }
}
