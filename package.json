{
  "name": "kakeibo-gas",
  "version": "0.1.0",
  "type": "module",
  "description": "Household budget (kakeibo) management on Google Sheets, built with Google Apps Script",
  "main": "dist/main.js",
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/connect0459/kakeibo-gas.git"
  },
  "keywords": [
    "gas",
    "google-apps-script",
    "kakeibo"
  ],
  "author": "connect0459",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/connect0459/kakeibo-gas/issues"
  },
  "homepage": "https://github.com/connect0459/kakeibo-gas#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@google/clasp": "3.4.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/google-apps-script": "2.0.13",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "rollup": "4.64.12",
    "rollup-plugin-cleanup": "3.2.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
